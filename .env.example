OLLAMA_API_KEY=""

# Ollama Cloud model to use for each phase (see https://ollama.com/library).
PLANNER_MODEL="deepseek-v4-pro"
INVESTIGATOR_MODEL="deepseek-v4-pro"
JUDGE_MODEL="deepseek-v4-pro"

# Optional: reasoning effort passed straight through to Ollama Cloud
# (e.g. "low"/"medium"/"high"/"max" - accepted values depend on the model,
# check https://ollama.com/library/<model>). Leave empty to use the model's
# own default.
REASONING_EFFORT=""

# Host path to the single repository to scan with the micropad service.
TARGET_REPO_DIR="./target_repo"

# Host directory containing multiple repos to scan with the micropad-batch
# service. Every subdirectory here is analyzed, unless --list is used to
# point at a specific repos list file instead.
BATCH_REPOS_DIR="./repos"

GITHUB_TOKEN=""
# Docker user mapping
UID=1000
GID=1000

GITHUB_TOKEN_1=""
GITHUB_TOKEN_2=""
GITHUB_TOKEN_3=""
GITHUB_TOKEN_4=""
GITHUB_TOKEN_5=""
GITHUB_TOKEN_6=""
GITHUB_TOKEN_7=""
GITHUB_TOKEN_8=""
GOOGLE_API_KEY=""
LOG_FILE_PATH=".generated/microref/logs"
NUM_WORKERS=20

FILTER_MIN_STARS=10
FILTER_MIN_AGE_MONTHS=6
FILTER_MIN_CONTRIBUTORS=2
FILTER_MIN_COMMITS=5
FILTER_MIN_SIZE_KB=100
FILTER_MAX_SIZE_KB=100000
OUTPUT_DIR=".generated/microref/out/repositories"
LOG_LEVEL=INFO
FILTER_MIN_GLOB_MATCHES=0
FILTER_REQUIRE_VALID_EMAILS=true

GLOB_PATTERNS_DIR=".generated/microref/generated_patterns"
PATTERN_GENERATOR_INPUT_CSV="experiment_data/microref/pattern_input.csv"
PATTERN_GENERATOR_OUTPUT_DIR=".generated/microref/generated_patterns"
PATTERN_GENERATOR_EXAMPLE_YAML="config/patterns/service_mesh.yaml"

PATTERN_GENERATOR_MODEL="gpt-5-2025-08-07"
PATTERN_GENERATOR_SEED=20250928
PATTERN_GENERATOR_TEMPERATURE=0.0
PATTERN_GENERATOR_LOG_FILE=".generated/microref/logs/generation_log.jsonl"

INPUT_FILENAME="repositories.jsonl"
OUTPUT_FILENAME="repositories_filtered.jsonl"
DECISIONS_LOG_FILENAME="filter_decisions.log"

CSV_INPUT_FILENAME="repositories_filtered.jsonl"
CSV_OUTPUT_FILENAME="contributors.csv"
CSV_REPORT_FILENAME="contributors_report.txt"
CSV_DEDUPLICATE_CONTRIBUTORS=true